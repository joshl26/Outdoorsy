<!-- views/campgrounds/nearby.ejs -->
<link rel="stylesheet" href="<%= basePath %>/stylesheets/skeleton.css" />
<link rel="stylesheet" type="text/css" href="<%= basePath %>/stylesheets/campgrounds-nearby.css" />

<%
// Cloudinary helper for responsive images
function cloudinaryTransform(url, transform) {
  if (!url || typeof url !== 'string') return url;
  if (!url.includes('cloudinary.com')) return url;
  return url.replace('/upload/', `/upload/${transform}/`);
}
%>

<div class="fade-in">
  <div class="d-flex align-items-center justify-content-between mb-3">
    <h1 id="nearbyHeading" class="text-primary m-0">Nearby Campgrounds</h1>
    <div class="d-flex gap-2">
      <a class="btn btn-outline-secondary" href="<%= basePath %>/campgrounds">
        <i class="fas fa-list me-1" aria-hidden="true"></i>
        <span>Back to All</span>
      </a>
      <a class="btn btn-outline-secondary" href="<%= basePath %>/campgrounds/favorites">
        <i class="fas fa-heart me-1" aria-hidden="true"></i>
        <span>Favorites</span>
      </a>
    </div>
  </div>

  <!-- Filters section -->
  <section aria-labelledby="nearby-filters-heading" class="card mb-4 shadow-sm">
    <div class="card-body">
      <h2 id="nearby-filters-heading" class="h5 mb-3">Filters</h2>

      <form
        method="GET"
        action="<%= basePath %>/campgrounds/nearby"
        id="nearbyForm"
        class="filter-form g-3"
        novalidate
      >
        <fieldset>
          <legend class="visually-hidden">Search nearby campgrounds</legend>

          <!-- Row 1: Query + Sort -->
          <div class="row g-3 align-items-end">
            <div class="col-12 col-md-6 col-lg-5">
              <label for="q" class="form-label">Search</label>
              <input
                type="text"
                id="q"
                name="q"
                class="form-control"
                placeholder="Title, description, location..."
                value="<%= typeof q !== 'undefined' ? q : '' %>"
                inputmode="search"
              />
            </div>

            <div class="col-6 col-md-3 col-lg-2">
              <label for="sort" class="form-label">Sort By</label>
              <select id="sort" name="sort" class="form-select">
                <% if (sort === 'priceAsc') { %>
                  <option value="distance">Distance</option>
                  <option value="priceAsc" selected>Price: Low to High</option>
                  <option value="priceDesc">Price: High to Low</option>
                <% } else if (sort === 'priceDesc') { %>
                  <option value="distance">Distance</option>
                  <option value="priceAsc">Price: Low to High</option>
                  <option value="priceDesc" selected>Price: High to Low</option>
                <% } else { %>
                  <option value="distance" selected>Distance</option>
                  <option value="priceAsc">Price: Low to High</option>
                  <option value="priceDesc">Price: High to Low</option>
                <% } %>
              </select>
            </div>

            <div class="col-12 col-md-3 col-lg-5 order-md-last d-none d-md-flex justify-content-end gap-2">
              <button
                type="button"
                class="btn btn-outline-primary"
                id="useLocationBtn"
                aria-live="polite"
                aria-label="Use my current location to find nearby campgrounds"
              >
                <i class="fas fa-crosshairs me-1" aria-hidden="true"></i>
                <span>Use My Location</span>
              </button>
              <button type="submit" class="btn btn-primary">
                <i class="fas fa-location-arrow me-1" aria-hidden="true"></i>
                <span>Find Nearby</span>
              </button>
            </div>
          </div>

          <!-- Row 2 -->
          <div class="row g-3 mt-0 align-items-end">
            <div class="col-6 col-md-2 col-lg-2">
              <label for="minPrice" class="form-label">Min Price</label>
              <div class="input-group">
                <span class="input-group-text">$</span>
                <input
                  type="number"
                  id="minPrice"
                  name="minPrice"
                  class="form-control"
                  min="0"
                  step="1"
                  inputmode="numeric"
                  value="<%= typeof minPrice !== 'undefined' ? minPrice : '' %>"
                />
              </div>
            </div>

            <div class="col-6 col-md-2 col-lg-2">
              <label for="maxPrice" class="form-label">Max Price</label>
              <div class="input-group">
                <span class="input-group-text">$</span>
                <input
                  type="number"
                  id="maxPrice"
                  name="maxPrice"
                  class="form-control"
                  min="0"
                  step="1"
                  inputmode="numeric"
                  value="<%= typeof maxPrice !== 'undefined' ? maxPrice : '' %>"
                />
              </div>
            </div>

            <div class="col-6 col-md-2 col-lg-2">
              <label for="lat" class="form-label">Latitude</label>
              <input
                type="number"
                id="lat"
                name="lat"
                class="form-control"
                step="0.000001"
                min="-90"
                max="90"
                inputmode="decimal"
                placeholder="e.g. 43.65"
                value="<%= typeof lat !== 'undefined' && lat !== '' ? lat : '' %>"
              />
            </div>

            <div class="col-6 col-md-2 col-lg-2">
              <label for="lng" class="form-label">Longitude</label>
              <input
                type="number"
                id="lng"
                name="lng"
                class="form-control"
                step="0.000001"
                min="-180"
                max="180"
                inputmode="decimal"
                placeholder="-79.38"
                value="<%= typeof lng !== 'undefined' && lng !== '' ? lng : '' %>"
              />
            </div>

            <div class="col-12 col-md-4 col-lg-4">
              <label for="radiusKm" class="form-label d-flex align-items-center justify-content-between">
                <span>Radius (km)</span>
                <small class="text-muted ms-2">max 500</small>
              </label>
              <div class="input-group">
                <input
                  type="number"
                  id="radiusKm"
                  name="radiusKm"
                  class="form-control"
                  min="1"
                  max="500"
                  step="1"
                  inputmode="numeric"
                  value="<%= typeof radiusKm !== 'undefined' && radiusKm !== '' ? radiusKm : 25 %>"
                  aria-describedby="radiusHelp"
                />
                <span class="input-group-text">km</span>
              </div>
              <div id="radiusHelp" class="form-text">Distance in kilometers</div>
            </div>
          </div>

          <div class="d-flex d-md-none gap-2 mt-3">
            <button type="button" class="btn btn-outline-primary flex-grow-1" id="useLocationBtn_sm">
              <i class="fas fa-crosshairs me-1" aria-hidden="true"></i>
              Use My Location
            </button>
            <button type="submit" class="btn btn-primary flex-grow-1">
              <i class="fas fa-location-arrow me-1" aria-hidden="true"></i>
              Find Nearby
            </button>
          </div>
        </fieldset>
      </form>
    </div>
  </section>

  <% if (typeof inlineNotice !== 'undefined' && inlineNotice) { %>
    <div class="alert alert-info d-flex align-items-center" role="status">
      <i class="fas fa-info-circle me-2" aria-hidden="true"></i>
      <div><%= inlineNotice %></div>
    </div>
  <% } %>

  <!-- View Toggle -->
  <div class="d-flex justify-content-between align-items-center mb-3">
    <div class="btn-group" role="group">
      <input type="radio" class="btn-check" name="viewMode" id="viewGrid" checked />
      <label class="btn btn-outline-primary" for="viewGrid">
        <i class="fas fa-th me-1" aria-hidden="true"></i> Grid
      </label>
      <input type="radio" class="btn-check" name="viewMode" id="viewMap" />
      <label class="btn btn-outline-primary" for="viewMap">
        <i class="fas fa-map me-1" aria-hidden="true"></i> Map
      </label>
    </div>
  </div>

  <!-- Map Section -->
  <section aria-labelledby="nearby-map-heading">
    <h2 id="nearby-map-heading" class="visually-hidden">Map Results</h2>
    <div id="mapContainer" class="card mb-4 shadow-sm" style="display:none;">
      <!-- Skeleton Map -->
      <div class="skeleton-map"></div>

      <!-- Real Map -->
      <div class="card-body real-map-content" style="display:none;">
        <div
          id="nearbyStaticMap"
          class="ratio ratio-16x9 bg-light rounded js-static-map"
          data-token="<%- process.env.MAPBOX_TOKEN || '' %>"
          data-style="mapbox/outdoors-v12"
          data-zoom="<%= typeof radiusKm !== 'undefined' && radiusKm ? Math.max(4, Math.min(14, Math.round(12 - Math.log2(Math.max(1, radiusKm))))) : 10 %>"
          data-size="1200x675@2x"
          role="img"
          aria-label="Map preview of nearby campgrounds"
        ></div>
      </div>
    </div>
  </section>

  <!-- Grid Section -->
  <section aria-labelledby="nearby-results-heading" id="gridContainer">
    <h2 id="nearby-results-heading" class="visually-hidden">Campground Results</h2>

    <!-- Skeleton Grid (displayed before load) -->
    <div class="skeleton-grid row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4 mb-4">
      <% for (let i = 0; i < 6; i++) { %>
        <div class="col">
          <div class="skeleton-card">
            <div class="skeleton-card-img"></div>
            <div class="skeleton-card-body">
              <div class="skeleton skeleton-title"></div>
              <div class="skeleton skeleton-text"></div>
              <div class="skeleton skeleton-text short"></div>
              <div class="d-flex gap-2 mt-2 mb-3">
                <div class="skeleton skeleton-badge"></div>
                <div class="skeleton skeleton-badge"></div>
              </div>
              <div class="skeleton skeleton-btn"></div>
            </div>
          </div>
        </div>
      <% } %>
    </div>

    <!-- Real Grid (hidden until JS shows) -->
    <div class="real-grid-content" style="display:none;">
      <% if (!campgrounds.length) { %>
        <div class="alert alert-info">
          <i class="fas fa-info-circle me-2"></i> No campgrounds found matching your criteria.
        </div>
      <% } else { %>
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
          <% campgrounds.forEach((cg, idx) => { 
               const cover = (cg.images && cg.images.length) ? cg.images[0].url : 'https://placehold.co/600x400?text=No+Image';
               const isCloudinary = cover.includes('cloudinary.com');
          %>
            <div class="col">
              <article class="card h-100 shadow-sm fade-in-content">
                <% if (isCloudinary) { %>
                  <img 
                    src="<%= cloudinaryTransform(cover, 'c_fill,g_auto,f_auto,q_auto,w_600,h_400') %>" 
                    srcset="
                      <%= cloudinaryTransform(cover, 'c_fill,g_auto,f_auto,q_auto,w_300,h_200') %> 300w,
                      <%= cloudinaryTransform(cover, 'c_fill,g_auto,f_auto,q_auto,w_600,h_400') %> 600w,
                      <%= cloudinaryTransform(cover, 'c_fill,g_auto,f_auto,q_auto,w_900,h_600') %> 900w
                    "
                    sizes="(max-width: 576px) 100vw, (max-width: 992px) 50vw, 33vw"
                    class="card-img-top" 
                    alt="<%= cg.title %> cover" 
                    width="600"
                    height="400"
                    loading="<%= idx < 6 ? 'eager' : 'lazy' %>"
                    decoding="async"
                    style="aspect-ratio: 3 / 2; object-fit: cover; object-position: center;"
                  />
                <% } else { %>
                  <img 
                    src="<%= cover %>" 
                    class="card-img-top" 
                    alt="<%= cg.title %> cover" 
                    width="600"
                    height="400"
                    loading="<%= idx < 6 ? 'eager' : 'lazy' %>"
                    decoding="async"
                    style="aspect-ratio: 3 / 2; object-fit: cover; object-position: center;"
                  />
                <% } %>
                <div class="card-body d-flex flex-column">
                  <h3 class="card-title h5">
<a class="text-decoration-none" href="<%= basePath %>/campgrounds/<%= cg.slug || cg._id %>"><%= cg.title %></a>                  </h3>
                  <p class="card-text text-muted mb-1">
                    <i class="fas fa-map-marker-alt me-1"></i> <%= cg.location %>
                  </p>
                  <div class="d-flex align-items-center gap-2 mb-2">
                    <div class="fw-bold">$<%= cg.price %>/night</div>
                    <% if (typeof cg.distance === 'number') { %>
                      <span class="badge bg-info-subtle text-info border">
                        <i class="fas fa-route me-1"></i> <%= (cg.distance/1000).toFixed(1) %> km
                      </span>
                    <% } %>
                  </div>
                  <div class="mt-auto d-flex gap-2">
<a class="btn btn-sm btn-primary flex-grow-1" href="<%= basePath %>/campgrounds/<%= cg.slug || cg._id %>">View</a>                    <% if (currentUser) { const fav = (favorites||[]).includes(String(cg._id)); %>
                      <button
                        type="button"
                        class="btn btn-sm <%= fav ? 'btn-danger' : 'btn-outline-danger' %> toggle-fav-btn"
                        data-id="<%= cg._id %>"
                        aria-pressed="<%= fav %>">
                        <i class="fas fa-heart"></i> Favorite
                      </button>
                    <% } %>
                  </div>
                </div>
              </article>
            </div>
          <% }) %>
        </div>
      <% } %>
    </div>
  </section>

  <!-- Pagination -->
  <% if (typeof totalPages !== 'undefined' && totalPages > 1) { %>
    <nav aria-label="Nearby pagination" class="mt-4">
      <ul class="pagination justify-content-center">
        <li class="page-item <%= page <= 1 ? 'disabled' : '' %>">
          <% if (page <= 1) { %>
            <span class="page-link">Previous</span>
          <% } else { %>
            <a class="page-link" href="?page=<%= page - 1 %>">Previous</a>
          <% } %>
        </li>
        <% for (let p = 1; p <= totalPages; p++) { %>
          <li class="page-item <%= p === page ? 'active' : '' %>">
            <% if (p === page) { %>
              <span class="page-link">Page <%= p %></span>
            <% } else { %>
              <a class="page-link" href="?page=<%= p %>">Page <%= p %></a>
            <% } %>
          </li>
        <% } %>
        <li class="page-item <%= page >= totalPages ? 'disabled' : '' %>">
          <% if (page >= totalPages) { %>
            <span class="page-link">Next</span>
          <% } else { %>
            <a class="page-link" href="?page=<%= page + 1 %>">Next</a>
          <% } %>
        </li>
      </ul>
    </nav>
  <% } %>

  <!-- Scripts -->
  <script defer src="<%= basePath %>/js/nearby-geolocate.js"></script>
  <script defer src="<%= basePath %>/js/nearby-static-map.js"></script>
  <script defer src="<%= basePath %>/js/nearby-view-toggle.js"></script>
</div>
